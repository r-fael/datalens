# ==============================================================================
# DATALENS — copie para .env na raiz e ajuste antes de subir.
# Portas do host (fixas no docker-compose.yml):
#   Frontend http://localhost:5173 | API http://localhost:9192 | Postgres localhost:5434
# ==============================================================================

# --- Banco de dados ---
POSTGRES_DB=dashboard
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=dashboard

# --- API ---
# development | production. Em servidor publico use production.
ENVIRONMENT=development
JWT_SECRET=troque-por-um-segredo-local-longo-e-aleatorio
# Origem do frontend (CORS). Aceita lista separada por virgula.
# Local: http://localhost:5173 | Producao: https://seu-dominio
FRONTEND_ORIGIN=http://localhost:5173
# Regex opcional para origens dinamicas (ex.: previews). Vazio = off.
FRONTEND_ORIGIN_REGEX=

# Primeiro usuario admin, criado no primeiro start.
# NAO use dominio .local: o validador rejeita TLDs reservados (login da HTTP 422).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-esta-senha-local
ADMIN_NAME=Admin

# --- Robo de e-mail (RPA) — so usado com o profile "rpa" ---
EMAIL_USER=seu_email@empresa.com
EMAIL_PASSWORD=sua_senha_de_aplicativo_aqui
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_MAILBOX=INBOX
# Pode receber multiplos assuntos separados por virgula.
EMAIL_SUBJECT_FILTER="Relatorio Logistico, Incidental Cost, Freight Air result, War Room, Vessel Report"
EMAIL_SENDER_FILTER=
EMAIL_DATE_FROM=2026-01-01
EMAIL_DATE_TO=2026-12-31
# Conta da API que o robo usa para enviar os dados (pode ser o mesmo admin).
RPA_API_EMAIL=admin@example.com
RPA_API_PASSWORD=troque-esta-senha-local
RPA_API_TIMEOUT=20

# ==============================================================================
# APENAS EM SERVIDOR COM TRAEFIK (ex.: a VPS) — nao usar em maquina local
# ------------------------------------------------------------------------------
# Faz o "docker compose up" incluir o override do Traefik automaticamente,
# sem precisar passar -f toda vez. Descomente na VPS:
# COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.traefik.yml
#
# Em producao troque tambem:
#   ENVIRONMENT=production
#   FRONTEND_ORIGIN=https://datalens.r-fael.com.br
# ==============================================================================
